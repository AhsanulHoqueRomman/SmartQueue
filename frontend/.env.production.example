# ==============================================================================
# QueueTurn Production Frontend Environment Template
# ==============================================================================
# These variables are baked into the client bundle at build time (`npm run build`).
# NEVER put backend secrets or database credentials in this file.
# ==============================================================================

# Backend API v1 Base URL (Must be an absolute HTTPS URL in production)
# Example: https://api.queueturn.com/api/v1
VITE_API_BASE_URL=https://api.queueturn.com/api/v1

# Optional OpenAPI Documentation URL override
# Defaults to VITE_API_BASE_URL replacing /api/v1 with /api/docs/
# VITE_API_DOCS_URL=https://api.queueturn.com/api/docs/

# Public QueueTurn support & contact info (displayed on public pages)
VITE_PUBLIC_SUPPORT_EMAIL=support@queueturn.com
VITE_PUBLIC_SUPPORT_PHONE=+880 1700-000000
VITE_PUBLIC_LOCATION=Dhaka, Bangladesh

# Optional published social profiles (leave empty if not currently active)
VITE_PUBLIC_FACEBOOK_URL=
VITE_PUBLIC_INSTAGRAM_URL=
VITE_PUBLIC_X_URL=
VITE_PUBLIC_YOUTUBE_URL=
