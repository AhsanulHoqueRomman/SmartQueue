# Local development only: production does not automatically load backend/.env.
# See docs/DEPLOYMENT.md for the process-environment production contract.
# Django Core Settings
SECRET_KEY=change-me-in-production-super-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DATABASE_NAME=smartqueue_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Resend email. Empty credentials retain failure-safe skipped sends.
# Get a key from https://resend.com/api-keys. Never commit real values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=QueueTurn Support
SMARTQUEUE_SUPPORT_EMAIL=
FRONTEND_URL=http://localhost:5173

# Production options below are examples, not a deployable configuration.
# SECURE_SSL_REDIRECT=True
# TRUST_X_FORWARDED_PROTO=False
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# F-024 requires a reviewed persistent, non-public storage root in production:
# PRIVATE_DOCUMENT_ROOT=/absolute/persistent/private-documents
# PRIVATE_DOCUMENT_STORAGE_PERSISTENT=true
# Alternative reviewed storage backend (no provider has been selected):
# PRIVATE_DOCUMENT_STORAGE_BACKEND=your.private.StorageBackend
# PRIVATE_DOCUMENT_STORAGE_OPTIONS={}
