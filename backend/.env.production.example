# ==============================================================================
# QueueTurn Production Backend Environment Template
# ==============================================================================
# CRITICAL SECURITY RULES:
# 1. NEVER commit real secrets, tokens, or passwords to Git.
# 2. In production, Django enforces DEBUG=False automatically.
# 3. Supply these variables via the hosting provider's environment settings
#    (e.g., Render / Railway / Fly.io / AWS ECS / Systemd environment).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production

# Must be a long, randomly generated secret (>= 50 chars, >= 5 unique chars).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-50-character-secret-generated-for-production-only-do-not-use-this-string

# Comma-separated list of fully qualified domain names serving the backend API.
# Prohibited: IP wildcards, URLs with http/https scheme, or port numbers.
# Example: api.queueturn.com
ALLOWED_HOSTS=api.queueturn.com

# Canonical HTTPS URL of the frontend client. Required for password reset links.
# Example: https://queueturn.com
FRONTEND_URL=https://queueturn.com

# ------------------------------------------------------------------------------
# 2. PostgreSQL Production Database
# ------------------------------------------------------------------------------
# QueueTurn strictly requires PostgreSQL in production. SQLite is rejected at startup.
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=queueturn_prod
DATABASE_USER=queueturn_app
DATABASE_PASSWORD=replace-with-a-strong-database-password-never-use-postgres-or-password
DATABASE_HOST=postgres.your-hosting-provider.internal
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# 3. CORS & CSRF Settings
# ------------------------------------------------------------------------------
# Comma-separated list of exact HTTPS origins allowed to make cross-origin API requests.
# CORS_ALLOW_ALL_ORIGINS is prohibited and rejected by production settings.
CORS_ALLOWED_ORIGINS=https://queueturn.com

# Comma-separated list of trusted HTTPS origins for CSRF protection on unsafe methods.
# Subdomain wildcards like https://*.queueturn.com are supported if needed.
CSRF_TRUSTED_ORIGINS=https://queueturn.com

# ------------------------------------------------------------------------------
# 4. HTTPS, Reverse Proxy & Security Headers
# ------------------------------------------------------------------------------
# Automatically redirects all HTTP traffic to HTTPS (default: True).
# Set to False only if HTTPS termination and redirection are strictly handled by reverse proxy (e.g. Cloudflare / Nginx).
SECURE_SSL_REDIRECT=True

# Set to True ONLY if running behind a trusted reverse proxy (e.g. AWS ALB, Render, Nginx)
# that sets X-Forwarded-Proto header and strips untrusted client headers.
TRUST_X_FORWARDED_PROTO=False

# HTTP Strict Transport Security (HSTS) settings.
# Start with 0 during initial domain verification; increase to 31536000 (1 year) once HTTPS is confirmed.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ------------------------------------------------------------------------------
# 5. Private Document Storage (F-024 Isolation & Persistence)
# ------------------------------------------------------------------------------
# Sensitive verification documents (licenses, certificates) must NEVER be served
# publicly via MEDIA_ROOT or static routes.
#
# Option A: Built-in local persistent disk storage (e.g., persistent volume mount)
PRIVATE_DOCUMENT_ROOT=/var/data/queueturn/private_documents
PRIVATE_DOCUMENT_STORAGE_PERSISTENT=true

# Option B: S3 / Cloud Object Storage Backend (if using storages / S3 backend)
# PRIVATE_DOCUMENT_STORAGE_BACKEND=storages.backends.s3boto3.S3Boto3Storage
# PRIVATE_DOCUMENT_STORAGE_OPTIONS={"bucket_name": "queueturn-private-documents", "default_acl": "private", "querystring_auth": false}
# PRIVATE_DOCUMENT_STORAGE_PERSISTENT=true

# ------------------------------------------------------------------------------
# 6. Transactional Email (Resend)
# ------------------------------------------------------------------------------
# If omitted or left empty, emails are safely skipped without failing user workflows.
# If configured, both API_KEY and FROM_EMAIL must be valid production values (test domains rejected).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=QueueTurn Notifications
SMARTQUEUE_SUPPORT_EMAIL=support@queueturn.com

# ------------------------------------------------------------------------------
# 7. Operational Logging & Backups (Reference)
# ------------------------------------------------------------------------------
# Production logging outputs structured messages to stdout/stderr for container log drivers.
# Database backups should be scheduled via pg_dump on the database host or cloud managed snapshots.
